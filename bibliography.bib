  author = {H{\"a}iki{\"o}, Tuomo and Bertram, Raymond and Hy{\"o}n{\"a}, Jukka},
  year = {2010},
  month = oct,
  journal = {Quarterly Journal of Experimental Psychology},
  volume = {63},
  number = {10},
