@article{patelMusicalSyntacticProcessing2008,
  title = {Musical Syntactic Processing in Agrammatic {{Broca}}'s Aphasia},
  author = {Patel, Aniruddh D. and Iversen, John R. and Wassenaar, Marlies and Hagoort, Peter},
  year = {2008},
