@article{pijpopsConstructionalContaminationHow2016,
  title = {Constructional Contamination: {{How}} Does It Work and How Do We Measure It?},
  shorttitle = {Constructional Contamination},
  author = {Pijpops, Dirk and {Van de Velde}, Freek},
  year = {2016},
  month = nov,
  journal = {Folia Linguistica},
  volume = {50},
  number = {2},
