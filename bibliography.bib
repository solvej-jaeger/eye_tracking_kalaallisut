@incollection{garnhamChapter1Observations2006,
  title = {Chapter 1 - {{Observations}} on the {{Past}} and {{Future}} of {{Psycholinguistics}}},
  booktitle = {Handbook of {{Psycholinguistics}} ({{Second Edition}})},
  author = {Garnham, Alan and Garrod, Simon and Sanford, Anthony},
  editor = {Traxler, Matthew J. and Gernsbacher, Morton A.},
  year = {2006},
