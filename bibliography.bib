@article{boyeGrammaticalizationConventionalizationDiscursively2023,
  title = {Grammaticalization as {{Conventionalization}} of {{Discursively Secondary Status}}: {{Deconstructing}} the {{Lexical}}--{{Grammatical Continuum}}},
  shorttitle = {Grammaticalization as {{Conventionalization}} of {{Discursively Secondary Status}}},
  author = {Boye, Kasper},
