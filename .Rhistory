# formatting p values
p_col <- which(colnames(tbl_ht) == "p")
for (i in 2:nrow(tbl_ht)) {  # skip header
p_val <- suppressWarnings(as.numeric(tbl_ht[i, p_col]))
if (!is.na(p_val)) {
# extremely small p-values
if (p_val < .001) {
tbl_ht[i, p_col] <- "<.001"
tbl_ht <- set_bold(tbl_ht, i, p_col, TRUE)
} else if (p_val < .05) {
# 3 decimals and remove leading zero
formatted <- sprintf("%.3f", p_val)
formatted <- sub("^0", "", formatted)
tbl_ht[i, p_col] <- formatted
bold(tbl_ht)[i, p_col] <- TRUE
} else {
# 2 decimals, keep leading zero
tbl_ht[i, p_col] <- sprintf("%.2f", p_val)
}
}
}
# make cells bold if they contain the string "<0.001"
current_bold <- bold(tbl_ht)[, "p"]
new_bold <- sapply(tbl_ht[, "p"], function(x) grepl("<0.001", x))
bold(tbl_ht)[, "p"] <- current_bold | new_bold
# indent row
level_rows <- which(tbl_ht[, 1] %in% c("lexical"))
left_padding(tbl_ht)[level_rows, 1] <- 20
tbl_ht
tbl_ffd <- tbl_regression(
model_ffd,
exponentiate = FALSE,
label = list(
affix_type ~ "suffix type",
affix_frequency_log ~ "suffix frequency",
affix_length ~ "suffix length",
predictability_log ~ "suffix predictability"
),
tidy_fun = function(x, ...) {
broom.mixed::tidy(x, effects = "fixed", conf.int = FALSE)
}
)
tbl_ffd <- tbl_regression(
model_ffd,
exponentiate = FALSE,
label = list(
affix_type ~ "suffix type",
affix_frequency_log ~ "suffix frequency",
affix_length ~ "suffix length",
predictability_log ~ "suffix predictability"
),
tidy_fun = function(x, ...) {
broom.mixed::tidy(x, effects = "fixed", conf.int = FALSE)
}
)
tbl_ffd <- tbl_ffd %>%
modify_header(
estimate ~ "β",
std.error ~ "SE",
statistic ~ "z",
p.value ~ "p"
) %>%
# hide unwanted columns if they exist
{if ("conf.low" %in% names(.$table_body))
modify_column_hide(., columns = c(conf.low, conf.high, ci))
else .} %>%
modify_table_styling(
columns = c(estimate, std.error, statistic),
fmt_fun = function(x) ifelse(is.na(as.numeric(x)), x, sprintf("%.2f", as.numeric(x)))
)
# delete abbreviations
tbl_ffd$table_styling$abbreviation <- tibble(
column = character(),
abbreviation = character(),
text_interpret = character()
)
# remove the reference level for structural status and relabel
tbl_ffd <- tbl_ffd %>%
modify_table_body(
~ .x %>%
dplyr::filter(
# remove reference level
!(label == "grammatical" & is.na(estimate)),
# remove the variable header row
label != "suffix type"
) %>%
dplyr::mutate(
label = dplyr::case_when(
label == "lexical" ~ "structural status (lexical vs. grammatical)",
TRUE ~ label
)
)
)
# create huxtable
tbl_ffd_ht <- tbl_ffd %>%
as_tibble() %>%
as_hux()
# italicize statistical symbols in header
stat_cols <- which(colnames(tbl_ffd_ht) %in% c("β","z","p"))
italic(tbl_ffd_ht)[1, stat_cols] <- TRUE
# right-align numeric columns
num_cols <- which(colnames(tbl_ffd_ht) %in% c("β", "SE", "z", "p"))
align(tbl_ffd_ht)[, num_cols] <- "right"
align(tbl_ffd_ht)[, 1] <- "left"
# add caption
caption(tbl_ffd_ht) <-
"Regression results for the FFD model"
# add footnote
tbl_ffd_ht <- add_footnote(
tbl_ffd_ht,
"Regression results for the first fixation duration model. Suffix frequency and predictability are log10 transformed. Significant effects (p<.05) are highlighted in bold."
)
# merge the footnote row
tbl_ffd_ht <- merge_cells(tbl_ffd_ht,
row = nrow(tbl_ffd_ht),
col = 1:ncol(tbl_ffd_ht))
# horizontal rule above header
top_border(tbl_ffd_ht)[1, ] <- 1
# horizontal rule below header
bottom_border(tbl_ffd_ht)[1, ] <- 1
# format column header
tbl_ffd_ht <- set_contents(tbl_ffd_ht, 1, 1, "Characteristic")
# formatting p values
p_col <- which(colnames(tbl_ffd_ht) == "p")
for (i in 2:nrow(tbl_ffd_ht)) {  # skip header
p_val <- suppressWarnings(as.numeric(contents(tbl_ffd_ht)[i, p_col]))
if (length(p_val) != 1 || is.na(p_val)) next
if (!is.na(p_val)) {
# extremely small p-values
if (p_val < .001) {
tbl_ffd_ht[i, p_col] <- "<.001"
bold(tbl_ffd_ht)[i, p_col] <- TRUE
} else if (p_val < .05) {
# 3 decimals and remove leading zero
formatted <- sprintf("%.3f", p_val)
formatted <- sub("^0", "", formatted)
tbl_ffd_ht[i, p_col] <- formatted
bold(tbl_ffd_ht)[i, p_col] <- TRUE
} else {
# 2 decimals, keep leading zero
tbl_ffd_ht[i, p_col] <- sprintf("%.2f", p_val)
}
}
}
# make cells bold if they contain the string "<0.001"
current_bold_ffd <- bold(tbl_ffd_ht)[, "p"]
new_bold_ffd <- sapply(tbl_ffd_ht[, "p"], function(x) grepl("<0.001", x))
bold(tbl_ffd_ht)[, "p"] <- current_bold_ffd | new_bold_ffd
tbl_ffd_ht
