source("R/02_read_data.R")
source("R/03_skewness_and_log_transformation.R")
source("R/04_suffix_models.R")
source("R/05_fixation_density_and_word_length.R")
source("R/06_fix_times_across_word_regions.R")
source("R/07_fix_times_across_baseline_words.R")
source("R/08_skipping_rates_suffixes_and_words.R")
source("R/09_regression_rates.R")
