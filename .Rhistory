bottom_border(tbl_gd_ht)[1, ] <- 1
# format column header
tbl_gd_ht <- set_contents(tbl_gd_ht, 1, 1, "Characteristic")
# format p values
p_col <- which(colnames(tbl_gd_ht) == "p")
for (i in 2:nrow(tbl_gd_ht)) {  # skip header
p_val <- suppressWarnings(as.numeric(contents(tbl_gd_ht)[i, p_col]))
if (length(p_val) != 1 || is.na(p_val)) next
if (!is.na(p_val)) {
# extremely small p-values
if (p_val < .001) {
tbl_gd_ht[i, p_col] <- "<.001"
bold(tbl_gd_ht)[i, p_col] <- TRUE
} else if (p_val < .05) {
# 3 decimals and remove leading zero
formatted <- sprintf("%.3f", p_val)
formatted <- sub("^0", "", formatted)
tbl_gd_ht[i, p_col] <- formatted
bold(tbl_gd_ht)[i, p_col] <- TRUE
} else {
# 2 decimals, keep leading zero
tbl_gd_ht[i, p_col] <- sprintf("%.2f", p_val)
}
}
}
# make cells bold if they contain the string "<0.001"
current_bold_gd <- bold(tbl_gd_ht)[, "p"]
new_bold_gd <- sapply(tbl_gd_ht[, "p"], function(x) grepl("<0.001", x))
bold(tbl_gd_ht)[, "p"] <- current_bold_gd | new_bold_gd
tbl_gd_ht
View(tbl_gd_ht)
# create huxtable
tbl_gd_ht <- tbl_gd %>%
as_tibble() %>%
as_hux()
# italicize statistical symbols in header
stat_cols <- which(colnames(tbl_gd_ht) %in% c("β","z","p"))
italic(tbl_gd_ht)[1, stat_cols] <- TRUE
# right-align numeric columns
num_cols <- which(colnames(tbl_gd_ht) %in% c("β", "SE", "z", "p"))
align(tbl_gd_ht)[, num_cols] <- "right"
align(tbl_gd_ht)[, 1] <- "left"
# horizontal rule above header
top_border(tbl_gd_ht)[1, ] <- 1
# horizontal rule below header
bottom_border(tbl_gd_ht)[1, ] <- 1
# format column header
tbl_gd_ht <- set_contents(tbl_gd_ht, 1, 1, "Characteristic")
# format p values
p_col <- which(colnames(tbl_gd_ht) == "p")
for (i in 2:nrow(tbl_gd_ht)) {  # skip header
p_val <- suppressWarnings(as.numeric(contents(tbl_gd_ht)[i, p_col]))
if (length(p_val) != 1 || is.na(p_val)) next
if (!is.na(p_val)) {
# extremely small p-values
if (p_val < .001) {
tbl_gd_ht[i, p_col] <- "<.001"
bold(tbl_gd_ht)[i, p_col] <- TRUE
} else if (p_val < .05) {
# 3 decimals and remove leading zero
formatted <- sprintf("%.3f", p_val)
formatted <- sub("^0", "", formatted)
tbl_gd_ht[i, p_col] <- formatted
bold(tbl_gd_ht)[i, p_col] <- TRUE
} else {
# 2 decimals, keep leading zero
tbl_gd_ht[i, p_col] <- sprintf("%.2f", p_val)
}
}
}
# make cells bold if they contain the string "<0.001"
current_bold_gd <- bold(tbl_gd_ht)[, "p"]
new_bold_gd <- sapply(tbl_gd_ht[, "p"], function(x) grepl("<0.001", x))
bold(tbl_gd_ht)[, "p"] <- current_bold_gd | new_bold_gd
tbl_gd_ht
